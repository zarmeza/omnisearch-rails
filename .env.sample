# Copy to .env and fill in. Google and Bing are both optional: a search runs
# with whichever providers are configured, and the aggregate status reports the
# ones that are not.
GOOGLE_ENGINE_ID=<YOUR GOOGLE ENGINE ID>
GOOGLE_API_KEY=<YOUR GOOGLE API KEY>
BING_SUBSCRIPTION_KEY=<YOUR BING SUBSCRIPTION KEY>

# Optional. Defaults to redis://localhost:6379. If no Redis is reachable the app
# runs uncached instead of failing, so this is only needed to enable caching.
REDIS_URL=
